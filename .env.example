# Copy this file to .env when the application needs local configuration.
# Never commit real secrets to Git.

PORT=3000
HOST=127.0.0.1
# Set this to your existing PostgreSQL connection URI with pgvector enabled.
# Do not commit the real value from your .env file.
DATABASE_URL=postgres://user:password@your-postgres-host:5432/database?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER=mock
AI_USER_DAILY_TOKEN_LIMIT=1000000
AI_GLOBAL_DAILY_TOKEN_LIMIT=5000000
AI_MAX_OUTPUT_TOKENS=512
# Optional server-side GitHub API token to raise the shared public-repository API quota.
# Create a fine-grained token with public repository read-only access; never commit the value.
# GITHUB_API_TOKEN=your-read-only-github-token
# Free-tier Gemini option: create a key in Google AI Studio, then uncomment.
# AI_PROVIDER=gemini
# AI_API_KEY=your-private-gemini-api-key
# AI_CHAT_MODEL=gemini-2.5-flash
# AI_EMBEDDING_MODEL=gemini-embedding-001
# Groq is supported later as a chat-only OpenAI-compatible option; keep Gemini for embeddings.
